# ── Core ──────────────────────────────────────────────────────────────────────
API_KEY=change-me
SANDBOX_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=polsia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polsia

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Claude CLI ────────────────────────────────────────────────────────────────
CLAUDE_CLI_PATH=/usr/local/bin/claude

# ── Schedule (24h, Asia/Kolkata) ──────────────────────────────────────────────
MORNING_CYCLE_HOUR=10
EVENING_CYCLE_HOUR=20

# ── Integrations (leave blank to keep sandbox) ────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

SENDGRID_API_KEY=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

TAVILY_API_KEY=

GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

GITHUB_TOKEN=
